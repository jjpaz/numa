# Local, clearly labelled in-memory demonstration. No external credentials required.
NUMA_DEMO_MODE=true
NUMA_SESSION_SECRET=local-only-change-before-deployment
NUMA_PATIENT_PASSWORD=journal-demo
NUMA_SAMPLE_PASSWORD=sample-demo
NUMA_CLINICIAN_PASSWORD=care-demo
NUMA_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Local Vite proxies /api. Set this for a separately deployed frontend:
VITE_API_BASE=
# Set false only after configuring ALL production settings below.
DATABASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
NUMA_VOICE_MODEL=speechbrain/emotion-recognition-wav2vec2-IEMOCAP
NUMA_MODEL_REVISION=main
NUMA_SEED_DEMO=false
