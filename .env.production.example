NUMA_DEMO_MODE=false
NUMA_ML_ENABLED=false
NUMA_SEED_DEMO=true
NUMA_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
NUMA_PATIENT_PASSWORD=REPLACE_WITH_UNIQUE_DEMO_PASSWORD
NUMA_SAMPLE_PASSWORD=REPLACE_WITH_UNIQUE_DEMO_PASSWORD
NUMA_CLINICIAN_PASSWORD=REPLACE_WITH_UNIQUE_DEMO_PASSWORD
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/defaultdb?sslmode=verify-full
GEMINI_API_KEY=REPLACE_IN_SECRET_STORE
GEMINI_MODEL=gemini-3.8-flash
NUMA_MODEL_REVISION=main
NUMA_ALLOWED_ORIGINS=https://YOUR-PROJECT.vercel.app
# Frontend build environment ONLY. Do not put any server secrets in VITE_* variables.
VITE_API_BASE=https://YOUR-MODAL-APP.modal.run
