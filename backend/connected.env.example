# Copy to .local/connected.env and fill locally. Never send the values in chat.
NUMA_DEMO_MODE=false
NUMA_DEMO_NAME_LOGIN=false
NUMA_ML_ENABLED=false
NUMA_SEED_DEMO=true
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/defaultdb?sslmode=verify-full
TEST_DATABASE_URL=postgresql+psycopg://TEST_USER:TEST_PASSWORD@HOST:PORT/numa_test?sslmode=verify-full
GEMINI_API_KEY=REPLACE_WITH_YOUR_KEY_LOCALLY
GEMINI_MODEL=REPLACE_WITH_LISTED_AUDIO_JSON_VERIFIED_MODEL
NUMA_ALLOWED_ORIGINS=https://numa-one-xi.vercel.app
# Existing account passwords and NUMA_SESSION_SECRET in numa-secrets are preserved.
# Use --ca-file .local/aiven-ca.pem to inject the Aiven project CA certificate.
